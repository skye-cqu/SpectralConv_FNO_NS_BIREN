#include <supa.h>

struct ComplexFloat {
    float real;
    float imag;
};

__global__ void complex_mul_forward_kernel(
    const ComplexFloat* input,
    const ComplexFloat* weight,
    ComplexFloat* output,
    int batch_size,
    int in_channels,
    int out_channels,
    int mode_count) {
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    const int total = batch_size * out_channels * mode_count;
    if (index >= total) {
        return;
    }

    const int mode = index % mode_count;
    const int out_channel = (index / mode_count) % out_channels;
    const int batch = index / (mode_count * out_channels);
    float real_sum = 0.0f;
    float imag_sum = 0.0f;
    for (int in_channel = 0; in_channel < in_channels; ++in_channel) {
        const ComplexFloat x =
            input[(batch * in_channels + in_channel) * mode_count + mode];
        const ComplexFloat w =
            weight[(in_channel * out_channels + out_channel) *
                mode_count + mode];
        real_sum += x.real * w.real - x.imag * w.imag;
        imag_sum += x.real * w.imag + x.imag * w.real;
    }
    output[index].real = real_sum;
    output[index].imag = imag_sum;
}

__global__ void complex_mul_backward_input_kernel(
    const ComplexFloat* grad_output,
    const ComplexFloat* weight,
    ComplexFloat* grad_input,
    int batch_size,
    int in_channels,
    int out_channels,
    int mode_count) {
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    const int total = batch_size * in_channels * mode_count;
    if (index >= total) {
        return;
    }

    const int mode = index % mode_count;
    const int in_channel = (index / mode_count) % in_channels;
    const int batch = index / (mode_count * in_channels);
    float real_sum = 0.0f;
    float imag_sum = 0.0f;
    for (int out_channel = 0; out_channel < out_channels; ++out_channel) {
        const ComplexFloat grad =
            grad_output[(batch * out_channels + out_channel) *
                mode_count + mode];
        const ComplexFloat w =
            weight[(in_channel * out_channels + out_channel) *
                mode_count + mode];
        real_sum += grad.real * w.real + grad.imag * w.imag;
        imag_sum += grad.imag * w.real - grad.real * w.imag;
    }
    grad_input[index].real = real_sum;
    grad_input[index].imag = imag_sum;
}

__global__ void complex_mul_backward_weight_kernel(
    const ComplexFloat* grad_output,
    const ComplexFloat* input,
    ComplexFloat* grad_weight,
    int batch_size,
    int in_channels,
    int out_channels,
    int mode_count) {
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    const int total = in_channels * out_channels * mode_count;
    if (index >= total) {
        return;
    }

    const int mode = index % mode_count;
    const int out_channel = (index / mode_count) % out_channels;
    const int in_channel = index / (mode_count * out_channels);
    float real_sum = 0.0f;
    float imag_sum = 0.0f;
    for (int batch = 0; batch < batch_size; ++batch) {
        const ComplexFloat x =
            input[(batch * in_channels + in_channel) * mode_count + mode];
        const ComplexFloat grad =
            grad_output[(batch * out_channels + out_channel) *
                mode_count + mode];
        real_sum += x.real * grad.real + x.imag * grad.imag;
        imag_sum += x.real * grad.imag - x.imag * grad.real;
    }
    grad_weight[index].real = real_sum;
    grad_weight[index].imag = imag_sum;
}

extern "C" void launch_complex_mul_forward(
    const void* input,
    const void* weight,
    void* output,
    int batch_size,
    int in_channels,
    int out_channels,
    int mode_count,
    suStream_t stream) {
    const int threads = 256;
    const int total = batch_size * out_channels * mode_count;
    const int blocks = (total + threads - 1) / threads;
    complex_mul_forward_kernel<<<blocks, threads, 0, stream>>>(
        static_cast<const ComplexFloat*>(input),
        static_cast<const ComplexFloat*>(weight),
        static_cast<ComplexFloat*>(output),
        batch_size,
        in_channels,
        out_channels,
        mode_count);
}

extern "C" void launch_complex_mul_backward_input(
    const void* grad_output,
    const void* weight,
    void* grad_input,
    int batch_size,
    int in_channels,
    int out_channels,
    int mode_count,
    suStream_t stream) {
    const int threads = 256;
    const int total = batch_size * in_channels * mode_count;
    const int blocks = (total + threads - 1) / threads;
    complex_mul_backward_input_kernel<<<blocks, threads, 0, stream>>>(
        static_cast<const ComplexFloat*>(grad_output),
        static_cast<const ComplexFloat*>(weight),
        static_cast<ComplexFloat*>(grad_input),
        batch_size,
        in_channels,
        out_channels,
        mode_count);
}

extern "C" void launch_complex_mul_backward_weight(
    const void* grad_output,
    const void* input,
    void* grad_weight,
    int batch_size,
    int in_channels,
    int out_channels,
    int mode_count,
    suStream_t stream) {
    const int threads = 256;
    const int total = in_channels * out_channels * mode_count;
    const int blocks = (total + threads - 1) / threads;
    complex_mul_backward_weight_kernel<<<blocks, threads, 0, stream>>>(
        static_cast<const ComplexFloat*>(grad_output),
        static_cast<const ComplexFloat*>(input),
        static_cast<ComplexFloat*>(grad_weight),
        batch_size,
        in_channels,
        out_channels,
        mode_count);
}
